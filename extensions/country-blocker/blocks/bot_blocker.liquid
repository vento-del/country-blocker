<div id="bot-blocker" data-enabled='{{ shop.metafields.botblocker.enabled }}'></div>

<!-- Honeypot elements - hidden from humans but visible to bots -->
<div style="position: absolute; left: -9999px; top: -9999px; visibility: hidden;">
  <a href="/bot-trap" id="honeypot-link">Do not click this link</a>
  <form id="honeypot-form" action="/bot-trap" method="get">
    <input type="text" name="honeypot-field" id="honeypot-input" autocomplete="off">
    <button type="submit">Submit</button>
  </form>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const botBlockerElement = document.getElementById('bot-blocker');
    const botBlockingEnabled = botBlockerElement.getAttribute('data-enabled') === 'true';
    
    if (botBlockingEnabled) {
      console.log('Bot blocking is enabled');
      
      // List of common bot user agents to block
      const bots = [
        'googlebot',
        'bingbot',
        'slurp',
        'duckduckbot',
        'baiduspider',
        'yandexbot',
        'sogou',
        'exabot',
        'facebookexternalhit',
        'ia_archiver',
        'twitterbot',
        'whatsapp',
        'linkedinbot',
        'bot',
        'spider',
        'crawl'
      ];
      
      // Function to block access
      function blockAccess(reason) {
        console.log('Bot detected via ' + reason + ', blocking access');
        
        // Clear the entire page content
        document.documentElement.innerHTML = '';
        
        // Create and display a simple message
        const blockedMessage = document.createElement('div');
        blockedMessage.style.cssText = `
          position: fixed;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          display: flex;
          justify-content: center;
          align-items: center;
          background-color: #f8f8f8;
          z-index: 9999;
          font-family: sans-serif;
        `;
        
        blockedMessage.innerHTML = `
          <div style="text-align: center; padding: 20px; max-width: 600px;">
            <h1 style="color: #333; font-size: 24px;">Access Denied</h1>
            <p style="color: #666; font-size: 16px;">This website does not allow automated access.</p>
          </div>
        `;
        
        document.body.appendChild(blockedMessage);
        
        // Return a 403 status code in the HTTP response headers
        // Note: This is not possible with client-side JavaScript alone,
        // but we can simulate it by stopping further page execution
        return true;
      }
      
      // 1. User Agent Detection
      const userAgent = navigator.userAgent.toLowerCase();
      const isBot = bots.some(bot => userAgent.includes(bot));
      
      if (isBot) {
        blockAccess('user agent');
        return;
      }
      
      // 2. Honeypot Traps
      
      // Honeypot link trap
      document.getElementById('honeypot-link').addEventListener('click', function(e) {
        e.preventDefault();
        blockAccess('honeypot link');
      });
      
      // Honeypot form trap
      document.getElementById('honeypot-form').addEventListener('submit', function(e) {
        e.preventDefault();
        blockAccess('honeypot form');
      });
      
      // Honeypot input trap
      document.getElementById('honeypot-input').addEventListener('input', function() {
        blockAccess('honeypot input');
      });
      
      // 3. Advanced Bot Detection System
      const advancedBotDetection = (function() {
        // Check for headless browser indicators
        const isHeadless = () => {
          return (
            navigator.webdriver ||
            /HeadlessChrome/.test(navigator.userAgent) ||
            !navigator.userAgent ||
            window.outerWidth === 0 ||
            window.outerHeight === 0 ||
            navigator.plugins.length === 0 ||
            navigator.languages.length === 0 ||
            !navigator.hardwareConcurrency ||
            navigator.hardwareConcurrency > 16
          );
        };

        // Enhanced user interaction detection
        const hasNoUserInteraction = () => {
          let moved = false;
          let clicked = false;
          let scrolled = false;
          let keyPressed = false;
          let touchDetected = false;

          // Track various user interactions
          const trackInteraction = () => {
            moved = true;
          };
          const trackClick = () => {
            clicked = true;
          };
          const trackScroll = () => {
            scrolled = true;
          };
          const trackKeyPress = () => {
            keyPressed = true;
          };
          const trackTouch = () => {
            touchDetected = true;
          };

          // Add event listeners
          document.addEventListener('mousemove', trackInteraction, { passive: true });
          document.addEventListener('mousedown', trackClick, { passive: true });
          document.addEventListener('scroll', trackScroll, { passive: true });
          document.addEventListener('keydown', trackKeyPress, { passive: true });
          document.addEventListener('touchstart', trackTouch, { passive: true });
          document.addEventListener('touchmove', trackTouch, { passive: true });

          return new Promise((resolve) => {
            setTimeout(() => {
              // Clean up event listeners
              document.removeEventListener('mousemove', trackInteraction);
              document.removeEventListener('mousedown', trackClick);
              document.removeEventListener('scroll', trackScroll);
              document.removeEventListener('keydown', trackKeyPress);
              document.removeEventListener('touchstart', trackTouch);
              document.removeEventListener('touchmove', trackTouch);

              // Check if any user interaction was detected
              const hasInteraction = moved || clicked || scrolled || keyPressed || touchDetected;
              resolve(!hasInteraction); // Return true if NO interaction (suspicious)
            }, 5000); // Wait 5 seconds
          });
        };

        // Additional bot detection checks
        const performAdditionalChecks = () => {
          const suspiciousSignals = [];

          // Check for missing window properties that real browsers have
          if (typeof window.chrome === 'undefined' && /Chrome/.test(navigator.userAgent)) {
            suspiciousSignals.push('missing_chrome_object');
          }

          // Check for automation indicators
          if (window.callPhantom || window._phantom || window.phantom) {
            suspiciousSignals.push('phantom_detected');
          }

          if (window.Buffer) {
            suspiciousSignals.push('nodejs_buffer_detected');
          }

          // Check for Selenium indicators
          if (document.documentElement.getAttribute('selenium') || 
              document.documentElement.getAttribute('webdriver') ||
              document.documentElement.getAttribute('driver')) {
            suspiciousSignals.push('selenium_attributes');
          }

          // Check screen dimensions (headless browsers often have unusual dimensions)
          if (screen.width === 0 || screen.height === 0) {
            suspiciousSignals.push('invalid_screen_dimensions');
          }

          // Check for missing expected properties
          if (!navigator.permissions || !navigator.serviceWorker) {
            suspiciousSignals.push('missing_browser_apis');
          }

          return suspiciousSignals;
        };

        // Main detection function
        const detectBot = async () => {
          const headless = isHeadless();
          const noInteraction = await hasNoUserInteraction();
          const additionalSignals = performAdditionalChecks();
          
          const isSuspicious = headless || noInteraction || additionalSignals.length > 2;
          
          if (isSuspicious) {
            const reason = [];
            if (headless) reason.push('headless_browser');
            if (noInteraction) reason.push('no_user_interaction');
            if (additionalSignals.length > 0) reason.push(...additionalSignals);
            
            console.warn('🤖 Advanced bot detection triggered:', reason.join(', '));
            
            // Block the bot
            blockAccess('advanced detection: ' + reason.join(', '));
            
            // Optional: Report to analytics (you can customize this endpoint)
            try {
              // This would be your app's endpoint for logging bot attempts
              // For now, we'll just log it locally
              console.log('Bot detection report:', {
                url: location.href,
                userAgent: navigator.userAgent,
                timestamp: new Date().toISOString(),
                reasons: reason,
                screenDimensions: `${screen.width}x${screen.height}`,
                windowDimensions: `${window.innerWidth}x${window.innerHeight}`
              });
            } catch (error) {
              console.error('Failed to report bot detection:', error);
            }
          } else {
            console.log('✅ Advanced bot detection passed - user appears legitimate');
          }
        };

        return { detectBot };
      })();

      // Run advanced bot detection
      advancedBotDetection.detectBot();
      
      // Add robots meta tag to prevent indexing
      const robotsMeta = document.createElement('meta');
      robotsMeta.name = 'robots';
      robotsMeta.content = 'noindex, nofollow, noarchive';
      document.head.appendChild(robotsMeta);
      
      // Add X-Robots-Tag HTTP header equivalent meta tag
      const xRobotsMeta = document.createElement('meta');
      xRobotsMeta.httpEquiv = 'X-Robots-Tag';
      xRobotsMeta.content = 'noindex, nofollow, noarchive';
      document.head.appendChild(xRobotsMeta);
    } else {
      console.log('Bot blocking is disabled');
    }
  });
</script>

{% schema %}
{
  "name": "Bot Blocker",
  "target": "body",
  "class": "bot_blocker",
  "settings": []
}
{% endschema %}